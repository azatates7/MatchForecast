<?xml version="1.0" encoding="utf-8" ?>
<!--
  Log klasörü:
  Eski yol "${basedir}/../../../../MatchForecast.Logger/logs" yalnızca bin/Debug/net10.0 içinden çalışırken doğru yere
  çıkıyordu; "dotnet publish" çıktısında (ör. Docker'da /app) dört üst klasöre çıkıp dosya sisteminin köküne yazmaya
  çalışırdı. Artık klasör tek bir değişkenden okunur:
    - MATCHFORECAST_LOG_DIR ortam değişkeni tanımlıysa orası (ör. Docker'da volume bağlanan /app/logs veya /var/log/matchforecast),
    - tanımlı değilse uygulamanın çalıştığı klasörün altındaki "logs" (geliştirmede bin/Debug/net10.0/logs, Docker'da /app/logs).
  internalLogFile, NLog'un kendi hatalarını yazar ve konfigürasyon yüklenmeden önce açıldığı için değişken kullanamaz;
  bu yüzden doğrudan ${basedir}/logs altına yazılır.
-->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="${basedir}/logs/internal-nlog.txt">

  <variable name="logDir" value="${environment:MATCHFORECAST_LOG_DIR:whenEmpty=${basedir}/logs}" />

  <!-- Enable NLog.Web.AspNetCore ASP.NET Core layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- Define targets -->
  <targets>
    <!-- Daily rolling log file target -->
    <target xsi:type="File" name="dailyFile"
            fileName="${var:logDir}/matchforecast-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= | Exception\: ${exception:format=tostring}}"
            archiveEvery="Day"
            archiveFileName="${var:logDir}/archives/matchforecast-archive-{#}.log"
            archiveNumbering="Date"
            archiveDateFormat="yyyy-MM-dd"
            maxArchiveFiles="30" />

    <!-- Console target for local debugging -->
    <target xsi:type="Console" name="lifetimeConsole"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= | Exception\: ${exception:format=tostring}}" />
  </targets>

  <!-- Rules to map loggers to targets -->
  <rules>
    <!-- All logs, including ASP.NET Core -->
    <logger name="*" minlevel="Info" writeTo="dailyFile,lifetimeConsole" />
  </rules>
</nlog>